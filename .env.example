# Copy this file to .env and fill in values (never commit .env)
# Alternatively, set all credentials in config.yaml

APOLLO_API_KEY=your_apollo_api_key_here
SLACK_WEBHOOK_HIGH=https://hooks.slack.com/services/...
SLACK_WEBHOOK_MEDIUM=https://hooks.slack.com/services/...
SLACK_WEBHOOK_LOW=https://hooks.slack.com/services/...
GOOGLE_SHEET_ID=your_google_sheet_id_here
SERPAPI_KEY=your_serpapi_key_here

# ── Sign-in and sessions ─────────────────────────────────────────────────────
# Google sign-in (Google Identity Services). Create it in Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID → Web application, and add every
# address you sign in from to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
# A long random string that signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Market Radar (tracker/market_radar_*.py, /admin/market-radar) ────────────
# Required. Postgres; the mr_* tables create themselves on first use.
DATABASE_URL=postgresql://user:password@localhost:5432/northaxis
# Required. Claude reads the site, checks and ranks competitors, writes reports.
ANTHROPIC_API_KEY=
# Required. Google search (apify/google-search-scraper) and a real browser
# (apify/website-content-crawler) for sites that refuse a server.
APIFY_API_TOKEN=
# Optional: each feature reports itself as skipped without its key.
# Apollo: headcount growth, and a profile fallback for sites that block us.
# (APOLLO_API_KEY is listed at the top of this file.)
# Unipile, with a LinkedIn account connected there: competitors' LinkedIn posts.
UNIPILE_API_KEY=
UNIPILE_DSN=
# Companies House (free key): UK company filings.
COMPANIES_HOUSE_API_KEY=
# SEC EDGAR wants a name and a contact: "Northaxis Market Radar you@yourcompany.com".
SEC_USER_AGENT=
# Weekly update delivery: SMTP, or a Slack bot that is a member of the channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SLACK_BOT_TOKEN=
# The address links in emails point at (defaults to https://northaxis.outcomes.digital).
PUBLIC_BASE_URL=
# Hard cap per run, in dollars (default 1.00).
MR_RUN_COST_CAP_USD=1.00
# Weekly scheduled runs spend money unattended, so they are OFF unless
# MR_MONITOR_ENABLED=1 is set. MR_MONITOR_DISABLED=1 switches them off whatever
# else is set: keep it until you decide to turn weekly runs on.
MR_MONITOR_DISABLED=1
