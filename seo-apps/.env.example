# ═══════════════════════════════════════════════════════════════════════════
# Environment template. Copy to `.env` and fill in real values.
# NEVER commit the real .env — it holds live secrets.
# ═══════════════════════════════════════════════════════════════════════════

# ── Access (required) ────────────────────────────────────────────────────────
# Shared with the Northaxis platform service, which signs a short-lived pass
# with it for every signed-in user it sends here (server/routes/auth.js). Any
# long random string; set the SAME value on both services. Without it every
# API call is refused (unless NODE_ENV=development, for local work).
SEO_STUDIO_SECRET=

# ── Database (Location + Service Pages) ─────────────────────────────────────
# Railway: reference the project's Postgres (DATABASE_URL=${{Postgres.DATABASE_URL}}).
# Tables are created on first use, in their own schema (SEO_DB_SCHEMA,
# default seo_studio), so sharing the platform's database is safe.
DATABASE_URL=
# SEO_DB_SCHEMA=seo_studio
# Alternatively Supabase (used instead of DATABASE_URL when both are set).
# The service-role key is server-only and bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── File storage ─────────────────────────────────────────────────────────────
# Mount path of a Railway volume (e.g. /data). Robots Monitor, On-Page Audit,
# Market Potential, Competitor Analysis, Content Architect and the Knowledge
# Base save files; without a volume they are lost on every deploy.
SEO_DATA_ROOT=

# ── LLM / SERP providers ─────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CX=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_PSI_API_KEY=
SEMRUSH_API_KEY=
SERPER_API_KEY=

# Comp Res Beta API budget controls. These are enforced by the beta database
# reservation functions; the browser cannot increase or bypass either limit.
COMP_RES_BETA_MAX_UNITS_PER_RUN=10000
COMP_RES_BETA_MAX_UNITS_PER_DAY=100000
COMP_RES_BETA_USAGE_DAY_TIMEZONE=UTC
COMP_RES_BETA_PROVIDER_CACHE_TTL_HOURS=24
COMP_RES_BETA_RESERVATION_TTL_MINUTES=20

# ── GSC Explorer — Google Search Console service account (read-only) ────────
# Prefer the path if both are set. The service account must be added as a
# Restricted user on each target property in Search Console.
GSC_SERVICE_ACCOUNT_PATH=
GSC_SERVICE_ACCOUNT_JSON=
# GSC_FRESHNESS_DAYS=3
# GSC_MAX_HISTORY_MONTHS=16
# GSC_DAILY_CALL_CAP=2000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Jina Reader (r.jina.ai) — crawl fallback for JS-rendered / bot-walled pages ──
# Required: keyless requests get a Cloudflare 403 for every URL. Get one at https://jina.ai/reader
JINA_API_KEY=
